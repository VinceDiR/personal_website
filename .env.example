# Copy to .env for local development. Leave values blank to run without the contact form.
MAIL_SERVER=
EMAIL_PORT=587
EMAIL=
EMAIL_PW=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
SITE_URL=https://vincentdirenzo.com

# Optional. Signs the contact form's render-time token; derived from the secrets above when unset.
FORM_SECRET=

# Optional. Comma-separated previous FORM_SECRET values, still accepted when verifying a token.
# Set this while rotating FORM_SECRET so pages already open in a browser keep working.
FORM_SECRET_PREVIOUS=

# Optional spam tuning (defaults shown). Blocking is off until you set SPAM_BLOCK_ENABLED=1.
SPAM_FLAG_THRESHOLD=6
SPAM_BLOCK_THRESHOLD=12
SPAM_BLOCK_ENABLED=
